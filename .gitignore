# =============================================================================
# .gitignore for the PICRUSt2 16S Functional Inference Workflow
# =============================================================================

# R and RStudio user state
.Rhistory
.Rapp.history
.RData
*.RData
.Ruserdata
.Rproj.user/
*.Rproj.user
.Renviron

# Pipeline outputs are regenerated by running the notebooks. GitHub Markdown
# guides under R/notebooks/ and executed example reports under
# example/reference_results/reports/ remain tracked documentation.
results/
**/checkpoints/
**/console_output/

# User-provided study inputs stay local. Keep only the data instructions.
data/*
!data/README.md

# Project-local executables, environments, and downloaded databases are
# recreated by the setup scripts and must not be committed.
tools/
*.conda
__pycache__/
*.pyc

# Notebook dependency folders are unnecessary because the reports are
# self-contained. Local GitHub Pages assembly output is also regenerable.
R/notebooks/*_files/
_site/

# Bundled example inputs and curated reference results are tracked. Fresh
# example runs remain local and cannot be confused with the published snapshot.
example/run_results/

# Temporary files and operating-system metadata
*.tmp
*.temp
*~
.~*
.cache/
.quarto/
*.swp
*.swo
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
.fuse_hidden*
.directory
.Trash-*
.nfs*

# R package build products
/*.tar.gz
/*.Rcheck/
.Rbuildignore
vignettes/*.html
vignettes/*.pdf
inst/doc

# Logs, archives, and other generated documents outside results/
*.pdf
*.log
logs/
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Editor files
.vscode/
*.code-workspace
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
*.sublime-workspace
*.sublime-project

# Secrets and credentials
.env
.env.local
*.pem
*.key
credentials/
secrets/
.positai
